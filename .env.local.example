# Copiar a .env.local y completar con la URL de publicación CSV de la pestaña
# `criterios` del Google Sheet (Archivo > Compartir > Publicar en la Web > CSV).
# Mientras esta variable no esté definida, la página muestra los datos de
# ejemplo incluidos en src/data/criteriaData.ts.
VITE_CRITERIOS_CSV_URL=
